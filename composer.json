{
    "name": "tapalka/pingaro",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "darkaonline/l5-swagger": "^9.0",
        "elasticsearch/elasticsearch": "^9.1",
        "firebase/php-jwt": "^6.11",
        "geoip2/geoip2": "^3.2",
        "guzzlehttp/guzzle": "^7.8",
        "hisorange/browser-detect": "^5.0",
        "intervention/image": "^3.11",
        "jeroennoten/laravel-adminlte": "^3.15",
        "kalnoy/nestedset": "^6.0",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.10",
        "laravel/ui": "^4.0",
        "monarobase/country-list": "^3.6",
        "promphp/prometheus_client_php": "^2.14",
        "spatie/laravel-data": "^4.18",
        "spatie/laravel-permission": "^6.23",
        "spatie/laravel-stats": "^2.3",
        "thecoder/laravel-monolog-telegram": "^2.5"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.15",
        "barryvdh/laravel-ide-helper": "^3.5",
        "enlightn/security-checker": "^2.0",
        "fakerphp/faker": "^1.23",
        "friendsofphp/php-cs-fixer": "^3.75",
        "larastan/larastan": "^3.3",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5.3",
        "qossmic/deptrac": "^2.0",
        "squizlabs/php_codesniffer": "^3.13",
        "vimeo/psalm": "^6.13",
        "symfony/polyfill-intl-idn": "^1.29"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "lint": [
            "@php vendor/bin/pint --test",
            "@php vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "ide": [
            "@php artisan clear-compiled",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:models -N",
            "@php artisan ide-helper:eloquent",
            "@php artisan ide-helper:meta"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "process-timeout": 2000,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
